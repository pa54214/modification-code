if (!function_exists('nmm_amount_words')) {
    function nmm_amount_words($amount) {
        $amount = number_format((float)$amount, 2, '.', '');
        $parts = explode('.', $amount);
        $num = (int)$parts[0];
        $ones = array('', 'One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen');
        $tens = array('', '', 'Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety');
        $words = function($n) use (&$words, $ones, $tens) {
            if ($n < 20) return $ones[$n];
            if ($n < 100) return $tens[intdiv($n, 10)].($n % 10 ? ' '.$ones[$n % 10] : '');
            if ($n < 1000) return $ones[intdiv($n, 100)].' Hundred'.($n % 100 ? ' '.$words($n % 100) : '');
            if ($n < 100000) return $words(intdiv($n, 1000)).' Thousand'.($n % 1000 ? ' '.$words($n % 1000) : '');
            if ($n < 10000000) return $words(intdiv($n, 100000)).' Lakh'.($n % 100000 ? ' '.$words($n % 100000) : '');
            return $words(intdiv($n, 10000000)).' Crore'.($n % 10000000 ? ' '.$words($n % 10000000) : '');
        };
        $out = $words($num).' '.($num == 1 ? 'Rupee' : 'Rupees');
        if ((int)$parts[1]) $out .= ' and '.$words((int)$parts[1]).' Paise';
        return trim($out).' Only';
    }
}

