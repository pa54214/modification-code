    public function update_json_fee_collection($id, $inv, $new_data) {
        // 1. Fetch the deposit row by table ID
        $this->db->where('id', $id);
        $query = $this->db->get('student_fees_deposite');
        
        if ($query->num_rows() == 0) {
            return false;
        }

        $row = $query->row_array();
        
        // 2. Decode the amount_detail JSON column into an associative PHP array
        $amount_detail = json_decode($row['amount_detail'], true);

        // 3. Check if the invoice/receipt key exists inside the JSON array
        if (isset($amount_detail[$inv])) {
            // Update specific fields while keeping other properties intact
            $amount_detail[$inv]['received_by']     = $new_data['received_by'];
            $amount_detail[$inv]['payment_mode']    = $new_data['payment_mode'];
            $amount_detail[$inv]['amount']          = $new_data['amount'];
            $amount_detail[$inv]['amount_discount'] = $new_data['amount_discount'];
            $amount_detail[$inv]['amount_fine']     = $new_data['amount_fine'];

            // 4. Encode the array back to a JSON string and save it to the database
            $this->db->where('id', $id);
            $this->db->update('student_fees_deposite', [
                'amount_detail' => json_encode($amount_detail)
            ]);

            return true;
        }

        return false;
    }

    /**
     * Delete a specific JSON sub-key entry from amount_detail
     */
    public function delete_json_fee_collection($id, $inv) {
        // 1. Fetch the deposit row by table ID
        $this->db->where('id', $id);
        $query = $this->db->get('student_fees_deposite');
        
        if ($query->num_rows() == 0) {
            return false;
        }

        $row = $query->row_array();
        
        // 2. Decode JSON amount details
        $amount_detail = json_decode($row['amount_detail'], true);

        // 3. Check if the entry exists
        if (isset($amount_detail[$inv])) {
            // Remove the specific entry using its key (e.g., "1" or "2")
            unset($amount_detail[$inv]);

            // 4. If no other receipts remain in this record, delete the entire table row; otherwise, update JSON
            if (empty($amount_detail)) {
                $this->db->where('id', $id);
                $this->db->delete('student_fees_deposite');
            } else {
                $this->db->where('id', $id);
                $this->db->update('student_fees_deposite', [
                    'amount_detail' => json_encode($amount_detail)
                ]);
            }

            return true;
        }

        return false;
    }

