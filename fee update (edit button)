public function bulk_update_fee_collection() {
    if (!$this->input->is_ajax_request()) {
        exit('No direct script access allowed');
    }

    $records = $this->input->post('records');
    
    // FIX: Load the model here as well
    $this->load->model('Studentfeemaster_model');//Studentfeemaster_model

    if (!empty($records) && is_array($records)) {
        $success = true;
        foreach ($records as $row) {
            $id  = $row['id'];
            $inv = $row['inv'];
            $update_data = [
                'received_by'     => $row['collect_by'],
                'payment_mode'    => $row['payment_mode'],
                'amount'          => $row['amount'],
                'amount_discount' => $row['amount_discount'],
                'amount_fine'     => $row['amount_fine']
            ];
            if (!$this->Studentfeemaster_model->update_json_fee_collection($id, $inv, $update_data)) {
                $success = false;
            }
        }

        if ($success) {
            echo json_encode(['status' => 'success', 'message' => 'All records updated successfully']);
            return;
        }
    }

    echo json_encode(['status' => 'fail', 'message' => 'Bulk update failed']);
}

