var isGlobalEditing = false;

// Global "Edit All" / "Save Updates" Button Logic
$(document).on('click', '#global_edit_toggle_btn', function() {
    if (!isGlobalEditing) {
        // Switch to Edit mode for all rows
        $('.editable-field').prop('disabled', false);
        $('.btn-row-edit').hide();
        $('.btn-row-save').show();
        
        isGlobalEditing = true;
        $('#global_edit_toggle_btn').removeClass('btn-primary').addClass('btn-success');
        $('#global_btn_text').text('Save Updates');
        $(this).find('i').removeClass('fa-pencil').addClass('fa-save');
    } else {
        // Save All Data via AJAX
        var records = [];
        $('tbody tr[data-id]').each(function() {
            var tr = $(this);
            records.push({
                'id': tr.attr('data-id'),
                'inv': tr.attr('data-inv'),
                'collect_by': tr.find('[name="collect_by"]').val(),
                'payment_mode': tr.find('[name="payment_mode"]').val(),
                'amount': tr.find('[name="amount"]').val(),
                'amount_discount': tr.find('[name="amount_discount"]').val(),
                'amount_fine': tr.find('[name="amount_fine"]').val()
            });
        });

        if (records.length === 0) return;

        $.ajax({
            url: '<?php echo site_url('financereports/bulk_update_fee_collection'); ?>',
            type: 'POST',
            data: {
                'records': records,
                '<?php echo $this->security->get_csrf_token_name(); ?>': '<?php echo $this->security->get_csrf_hash(); ?>'
            },
            dataType: 'json',
            success: function(response) {
                if (response.status === 'success') {
                    alert(response.message || 'Records updated successfully.');
                    location.reload();
                } else {
                    alert(response.message || 'Update failed.');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                alert('Server communication error.');
            }
        });
    }
});

// Row-specific Edit Toggle
$(document).on('click', '.btn-row-edit', function() {
    var tr = $(this).closest('tr');
    tr.find('.editable-field').prop('disabled', false);
    $(this).hide();
    tr.find('.btn-row-save').show();
});

// Row-specific Save Update Click
$(document).on('click', '.btn-row-save', function() {
    var tr = $(this).closest('tr');
    var id = tr.attr('data-id');
    var inv = tr.attr('data-inv');
    var collect_by = tr.find('[name="collect_by"]').val();
    var payment_mode = tr.find('[name="payment_mode"]').val();
    var amount = tr.find('[name="amount"]').val();
    var amount_discount = tr.find('[name="amount_discount"]').val();
    var amount_fine = tr.find('[name="amount_fine"]').val();
    var btn = $(this);

    $.ajax({
        url: '<?php echo site_url('financereports/update_single_fee_collection'); ?>',
        type: 'POST',
        data: {
            'id': id,
            'inv': inv,
            'collect_by': collect_by,
            'payment_mode': payment_mode,
            'amount': amount,
            'amount_discount': amount_discount,
            'amount_fine': amount_fine,
            '<?php echo $this->security->get_csrf_token_name(); ?>': '<?php echo $this->security->get_csrf_hash(); ?>'
        },
        dataType: 'json',
        success: function(response) {
            if (response.status === 'success') {
                tr.find('.editable-field').prop('disabled', true);
                btn.hide();
                tr.find('.btn-row-edit').show();
                alert(response.message || 'Record updated successfully.');
            } else {
                alert(response.message || 'Update failed.');
            }
        },
        error: function(xhr) {
            console.log(xhr.responseText);
            alert('Server communication error.');
        }
    });
});

// Row-specific Delete Action
$(document).on('click', '.btn-row-delete', function() {
    var tr = $(this).closest('tr');
    var id = tr.attr('data-id');
    var inv = tr.attr('data-inv');

    if (confirm('Are you sure you want to delete this record?')) {
        $.ajax({
            url: '<?php echo site_url('financereports/delete_fee_collection'); ?>',
            type: 'POST',
            data: {
                'id': id,
                'inv': inv,
                '<?php echo $this->security->get_csrf_token_name(); ?>': '<?php echo $this->security->get_csrf_hash(); ?>'
            },
            dataType: 'json',
            success: function(response) {
                if (response.status === 'success') {
                    tr.fadeOut(300, function() { $(this).remove(); });
                    alert(response.message || 'Record deleted successfully.');
                } else {
                    alert(response.message || 'Deletion failed.');
                }
            },
            error: function(xhr) {
                console.log(xhr.responseText);
                alert('Server communication error during deletion.');
            }
        });
    }
});
</script>
